# Custom 404
ErrorDocument 404 /inventory/404.php

# Disable directory listing
Options -Indexes

# Security headers
Header always set X-Frame-Options "SAMEORIGIN"
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-XSS-Protection "1; mode=block"
Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; font-src https://cdn.jsdelivr.net; connect-src 'self'; img-src 'self' data:; object-src 'none'; frame-ancestors 'self';"
Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"

# Secure session cookies
php_value session.cookie_httponly 1
php_value session.cookie_secure 1
php_value session.cookie_samesite Strict
php_value session.gc_maxlifetime 1800

# Block direct web access to sensitive paths
<FilesMatch "\.(env|log|sh|sql|md|example)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Block dangerous file types in uploads
<FilesMatch "\.(php|phtml|php3|php4|php5|phar|exe|sh|bat|cmd)$">
    Order allow,deny
    Deny from all
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteRule ^inc/ - [F,L]
    RewriteRule ^sql/ - [F,L]
    RewriteRule ^uploads/.*\.php$ - [F,L]
</IfModule>
